{
  "name": "luca-dashboard",
  "compatibility_date": "2026-08-09",
  "preview_urls": false,
  // v1.36: a Worker script now sits in front of the static assets, but only
  // for /api/* — every other path is served from ./dist exactly as before.
  // Its three secrets are set in the Cloudflare dashboard, never here.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
