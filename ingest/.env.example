# Copy to ingest/.env and fill in real values. ingest/.env is gitignored
# (see repo .gitignore) — never commit real credentials (CLAUDE.md rule 8).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Supabase project this ingest writes to.
SUPABASE_URL=

# service_role key — bypasses RLS entirely, so this is NOT gated by the
# owner-only RLS policy on biometrics/activities (spec §5, §6 v1.4).
# Find it in the Supabase dashboard: Project Settings → API Keys →
# "service_role" (marked secret). Never the anon/publishable key here —
# that has zero table grants and every write would be rejected.
# GitHub Actions secret only once the sync workflow ships; local dev reads
# it from this gitignored file. Never printed, logged, or committed.
SUPABASE_SERVICE_ROLE_KEY=
